{
  "name": "equipment-rental-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:check": "tsx scripts/database.ts check",
    "db:setup": "tsx scripts/database.ts setup",
    "test:auth": "tsx scripts/test-auth.ts",
    "auth:create-admin": "tsx scripts/create-admin.ts",
    "db:seed": "tsx scripts/seed-equipment.ts",
    "test:equipment": "tsx scripts/test-equipment.ts",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.27",
    "better-auth": "1.7.27",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "mongodb": "7.9.1",
    "multer": "^2.5.0",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
