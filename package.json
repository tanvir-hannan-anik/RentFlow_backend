{
  "name": "equipment-rental-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/app.js && node --check src/server.js",
    "test": "node --test test/*.test.js",
    "db:check": "node scripts/database.js check",
    "db:setup": "node scripts/database.js setup",
    "test:auth": "node scripts/test-auth.js",
    "auth:create-admin": "node scripts/create-admin.js",
    "db:seed": "node scripts/seed-equipment.js",
    "test:equipment": "node scripts/test-equipment.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.27",
    "better-auth": "1.7.27",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "mongodb": "7.9.1"
  }
}
