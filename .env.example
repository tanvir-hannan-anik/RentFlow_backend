PORT=5000
NODE_ENV=development
# Exact frontend origins, separated by commas; no paths or wildcards.
CORS_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DATABASE_NAME=rentflow
# Public browser origin, not the internal backend host.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Google Cloud redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only service keys. No Stripe webhook is required.
STRIPE_SECRET_KEY=
IMGBB_API_KEY=
